// Lantern — anonymous incident reporting, verifiable participation
// Midnight Builder Challenge — Level 3 (First Quarter)
// Idea: Anonymous Feedback / Survey (whistleblower variant)
//
// PRIVACY MODEL
//   PUBLIC   : channel label, the aggregate incident-category tally,
//              how many reports included written detail, the set of
//              spent nullifiers, channel open/closed status.
//   PRIVATE  : the reporter's identity, the full text of every report,
//              and any link between a nullifier and who filed it.
//   PROVED WITHOUT REVEALING: that the caller holds a valid reporter
//              secret and has not filed through this channel before.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---------------------------------------------------------------------
// Ledger (PUBLIC on-chain state)
// ---------------------------------------------------------------------

export ledger channelLabel:       Bytes<32>;
export ledger categoryTally1:     Counter;
export ledger categoryTally2:     Counter;
export ledger categoryTally3:     Counter;
export ledger categoryTally4:     Counter;
export ledger categoryTally5:     Counter;
export ledger detailedReportCount: Counter;
export ledger reportCount:        Counter;
export ledger usedNullifiers:     Map<Bytes<32>, Boolean>;
export ledger isOpen:             Boolean;

// ---------------------------------------------------------------------
// Witnesses (PRIVATE — supplied locally by the reporter)
// ---------------------------------------------------------------------

witness reporterSecretKey(): Bytes<32>;
witness reportHasDetail():   Boolean;

// ---------------------------------------------------------------------
// Constructor
// ---------------------------------------------------------------------

constructor(label: Bytes<32>) {
  channelLabel = disclose(label);
  isOpen = true;
}

// ---------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------

// Derives a per-channel, per-reporter nullifier.
// Bound to this specific channel deployment (via channelLabel) and to
// the reporter's secret key. Same secret always produces the same
// nullifier for this channel and a different one for any other channel.
circuit deriveNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    channelLabel,
    sk
  ]);
}

// ---------------------------------------------------------------------
// Circuits
// ---------------------------------------------------------------------

// A reporter proves in zero-knowledge that they have a secret key and
// have not filed a report through this channel before.
// Only the aggregate category counter and the detail-count flag change
// on-chain. Reporter identity is never recorded.
export circuit submitReport(category: Uint<8>, hasDetail: Boolean): [] {
  assert(isOpen, "channel is closed");
  assert(category >= 1 && category <= 5, "category must be 1-5");

  const sk = reporterSecretKey();
  const nf = deriveNullifier(sk);

  assert(!usedNullifiers.member(disclose(nf)), "a report has already been filed by this reporter");
  usedNullifiers.insert(disclose(nf), true);

  if (disclose(category) == 1) { categoryTally1.increment(1); }
  if (disclose(category) == 2) { categoryTally2.increment(1); }
  if (disclose(category) == 3) { categoryTally3.increment(1); }
  if (disclose(category) == 4) { categoryTally4.increment(1); }
  if (disclose(category) == 5) { categoryTally5.increment(1); }

  reportCount.increment(1);

  if (disclose(hasDetail)) {
    detailedReportCount.increment(1);
  }
}

// Organization closes the channel. Aggregates remain exactly as they are.
export circuit closeChannel(): [] {
  assert(isOpen, "already closed");
  isOpen = false;
}
